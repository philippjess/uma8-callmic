+impl Drop for DfPlugin {
+    // LADSPA cleanup() drops the plugin. Without stopping the worker here, every
+    // instantiate/cleanup cycle leaked a thread that kept polling forever.
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        if let Some(h) = self._h.take() {
+            if h.join().is_err() {
+                log::error!("DF {} | Worker thread panicked", self.id);
+            }
+        }
+        log::info!("DF {} | cleanup", self.id);
+    }
+}
