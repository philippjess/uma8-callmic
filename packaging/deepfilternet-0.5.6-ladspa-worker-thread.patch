+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn thread_count() -> usize {
+        std::fs::read_dir("/proc/self/task").unwrap().count()
+    }
+
+    /// Thread count once it reaches `want`; a joined thread may stay listed for a moment.
+    fn settled_thread_count(want: usize) -> usize {
+        let t0 = Instant::now();
+        loop {
+            let n = thread_count();
+            if n == want || t0.elapsed() > Duration::from_secs(5) {
+                return n;
+            }
+            sleep(Duration::from_millis(10));
+        }
+    }
+
+    #[test]
+    fn cleanup_stops_worker_threads() {
+        for (index, channels) in [(0, 1), (1, 2)] {
+            let desc = get_ladspa_descriptor(index).unwrap();
+            // Warm-up: the first instance loads the model; one-off threads stay out of the baseline.
+            let before = thread_count();
+            drop((desc.new)(&desc, 48000));
+            let base = settled_thread_count(before);
+
+            let n = 8;
+            let plugins: Vec<_> = (0..n).map(|_| (desc.new)(&desc, 48000)).collect();
+            assert_eq!(thread_count(), base + n, "{channels} ch: one worker per instance");
+            drop(plugins);
+            assert_eq!(settled_thread_count(base), base, "{channels} ch: worker threads leaked");
+        }
+    }
+}
