+    /// Mono plugin with its worker thread stopped: the tests move the samples between the
+    /// queues themselves, so the queue lengths are deterministic.
+    fn plugin_without_worker(desc: &PluginDescriptor) -> DfPlugin {
+        let mut p = get_new_df(1)(desc, 48000);
+        p.stop.store(true, Ordering::Relaxed);
+        p._h.take().unwrap().join().unwrap();
+        p
+    }
+
+    /// Samples in the output queue, i.e. the real added latency after `cycle`
+    fn queued(p: &DfPlugin) -> usize {
+        p.o_rx.lock().unwrap()[0].len()
+    }
+
+    /// One host cycle of `n` samples through run(), then a worker that keeps up (all input moved
+    /// to the output queue).
+    fn cycle(desc: &PluginDescriptor, p: &mut DfPlugin, n: usize) {
+        let input = vec![0f32; n];
+        let mut output = vec![0f32; n];
+        // Same values as the control history, so nothing is sent to the stopped worker
+        let controls: Vec<f32> = desc.ports[2..]
+            .iter()
+            .map(|port| p.control_hist.get(&DfControl::from_port_name(port.name)))
+            .collect();
+        let mut conns = vec![
+            PortConnection { port: desc.ports[0], data: PortData::AudioInput(&input) },
+            PortConnection {
+                port: desc.ports[1],
+                data: PortData::AudioOutput(RefCell::new(&mut output)),
+            },
+        ];
+        for (port, v) in desc.ports[2..].iter().zip(controls.iter()) {
+            conns.push(PortConnection { port: *port, data: PortData::ControlInput(v) });
+        }
+        let refs: Vec<&PortConnection> = conns.iter().collect();
+        p.run(n, &refs);
+        let mut i_q = p.i_tx.lock().unwrap();
+        let mut o_q = p.o_rx.lock().unwrap();
+        for (i_ch, o_ch) in i_q.iter_mut().zip(o_q.iter_mut()) {
+            o_ch.extend(i_ch.drain(..));
+        }
+    }
+
+    /// Like `cycle`, but the output becomes available only 20 ms (two frames) late: an underrun
+    fn cycle_underrun(desc: &PluginDescriptor, p: &mut DfPlugin, n: usize) {
+        let held: Vec<VecDeque<f32>> =
+            p.o_rx.lock().unwrap().iter_mut().map(std::mem::take).collect();
+        let o_rx = Arc::clone(&p.o_rx);
+        let late = thread::spawn(move || {
+            sleep(Duration::from_millis(20));
+            for (o_ch, h) in o_rx.lock().unwrap().iter_mut().zip(held) {
+                o_ch.extend(h);
+            }
+        });
+        cycle(desc, p, n);
+        late.join().unwrap();
+    }
+
+    #[test]
+    fn latency_recovers_after_underruns() {
+        let _serial = serial();
+        let desc = get_ladspa_descriptor(0).unwrap();
+        let mut p = plugin_without_worker(&desc);
+        let (hop, sr) = (p.frame_size, p.sr);
+        // Half-frame host blocks: hold and step times must count samples, not run() calls
+        let n = hop / 2;
+        assert_eq!((p.proc_delay, queued(&p)), (hop, hop));
+        for k in 1..=3 {
+            cycle_underrun(&desc, &mut p, n);
+            assert_eq!((p.proc_delay, queued(&p)), (hop * (1 + k), hop * (1 + k)), "underrun {k}");
+        }
+        // 10 s after an underrun one frame less, then one per second, down to the initial
+        // one-frame buffer. A real underrun (test thread preempted) adds a frame and restarts
+        // the hold; the checks hold either way.
+        let (mut since_change, mut after_underrun, mut steps) = (0, true, 0);
+        for c in 1..=60 * sr / n {
+            let before = p.proc_delay;
+            cycle(&desc, &mut p, n);
+            since_change += n;
+            assert_eq!(queued(&p), p.proc_delay, "cycle {c}: real latency differs from proc_delay");
+            assert!(p.proc_delay >= hop, "cycle {c}: below the one-frame buffer");
+            if p.proc_delay > before {
+                assert_eq!(p.proc_delay - before, hop, "cycle {c}: one frame per underrun");
+                (since_change, after_underrun) = (0, true);
+            } else if p.proc_delay < before {
+                assert_eq!(before - p.proc_delay, hop, "cycle {c}: one frame per step");
+                let (min, max) = if after_underrun { (10 * sr, 15 * sr) } else { (sr, 3 * sr / 2) };
+                assert!(
+                    since_change > min && since_change <= max,
+                    "cycle {c}: step after {since_change} samples, expected {min}..{max}"
+                );
+                (since_change, after_underrun, steps) = (0, false, steps + 1);
+            } else if p.proc_delay == hop && since_change > 2 * sr {
+                break;
+            }
+        }
+        assert_eq!(p.proc_delay, hop, "latency not back at one frame after {steps} steps");
+        assert!(steps >= 3, "{steps} decrease steps");
+    }
+
+    #[test]
+    fn latency_is_capped_instead_of_panicking() {
+        let _serial = serial();
+        let desc = get_ladspa_descriptor(0).unwrap();
+        let mut p = plugin_without_worker(&desc);
+        let (hop, cap) = (p.frame_size, p.sr);
+        // As after many underruns: one frame below the cap
+        p.proc_delay = cap - hop;
+        for o_ch in p.o_rx.lock().unwrap().iter_mut() {
+            o_ch.resize(cap - hop, 0.);
+        }
+        cycle_underrun(&desc, &mut p, hop);
+        assert_eq!((p.proc_delay, queued(&p), p.capped_underruns), (cap, cap, 0));
+        // At the cap: no more latency, no panic; counted instead of logged
+        cycle_underrun(&desc, &mut p, hop);
+        assert_eq!((p.proc_delay, queued(&p), p.capped_underruns), (cap, cap, 1));
+    }
 }
